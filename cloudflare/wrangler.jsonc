{
  // P2PCLI 牵线服务（WebSocket 版）
  // 部署用同目录的 deploy.sh / deploy.ps1，域名在部署时传进去，这里不写死
  "name": "p2pcli-rdv",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "RDV", "class_name": "Rendezvous" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Rendezvous"] }]
}
