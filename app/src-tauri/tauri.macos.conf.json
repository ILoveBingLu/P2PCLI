{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "P2PCLI",
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 24
        },
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 520
      }
    ]
  },
  "bundle": {
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "installer/dmg-background.tiff",
        "windowSize": { "width": 660, "height": 466 },
        "appPosition": { "x": 180, "y": 196 },
        "applicationFolderPosition": { "x": 480, "y": 196 }
      }
    },
    "externalBin": [
      "binaries/tmux",
      "binaries/p2pcli"
    ],
    "resources": {
      "resources/session-tools/macos/": "session-tools/"
    }
  }
}
