{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "P2PCLI",
        "create": false,
        "decorations": false,
        "theme": "Dark",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 520
      }
    ]
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerHooks": "installer/nsis-hooks.nsh"
      }
    },
    "externalBin": [
      "binaries/psmux",
      "binaries/p2pcli"
    ],
    "resources": {
      "resources/session-tools/windows/": "session-tools/"
    }
  }
}
